{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "uographs",
  "version": "0.3.0",
  "description": "Use the local UO.Graphs CLI to inspect C#/.NET symbols, source-backed relationships and change impact. Requires a separately installed CLI and prepared graph index.",
  "author": {
    "name": "Ugur Ozturk",
    "url": "https://github.com/ugurozturk"
  },
  "repository": "https://github.com/ugurozturk/UO.DotGraphs",
  "license": "MIT",
  "keywords": [
    "csharp",
    "dotnet",
    "roslyn",
    "code-analysis"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "UO.Graphs",
        "shortDescription": "Inspect local C#/.NET code graphs",
        "category": "Productivity"
      }
    }
  }
}
